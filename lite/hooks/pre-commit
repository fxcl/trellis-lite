#!/usr/bin/env bash
# Trellis Lite pre-commit hook
#
# Install by copying or symlinking to .git/hooks/pre-commit:
#   ln -s ../../lite/hooks/pre-commit .git/hooks/pre-commit
# (or copy, if symlinks aren't allowed)
#
# What it checks (each is optional and skippable):
#   0. .trellis-lite/ is initialized (silent skip if not found)
#   1. doctor reports no problems (use --no-verify to skip when broken)
#   2. No active task in `planning` state (warn only)
#   3. Last done task has a complete WRAP phase (warn only)
#
# To bypass the hook entirely (e.g. urgent hotfix):
#   git commit --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
TRELLIS_DIR="$REPO_ROOT/.trellis-lite"
SCRIPT="$TRELLIS_DIR/scripts/trellis.py"

# Locate the script even if installed at a non-standard path
if [ ! -f "$SCRIPT" ]; then
    # Try lite-relative paths (when hook is installed via Trellis Lite)
    for candidate in "$REPO_ROOT/lite/.trellis-lite/scripts/trellis.py" \
                       "$REPO_ROOT/scripts/trellis.py"; do
        if [ -f "$candidate" ]; then
            SCRIPT="$candidate"
            break
        fi
    done
fi

# Skip silently if Trellis Lite is not installed in this repo
if [ ! -f "$SCRIPT" ]; then
    exit 0
fi

echo "Trellis Lite pre-commit checks..."

# Check 1: doctor must pass (warnings are OK, problems block the commit)
DOCTOR_OUTPUT="$(mktemp)"
if ! python3 "$SCRIPT" doctor > "$DOCTOR_OUTPUT" 2>&1; then
    echo ""
    echo "✗ Trellis Lite doctor found problems:"
    cat "$DOCTOR_OUTPUT"
    echo ""
    echo "Fix the issues above, or use 'git commit --no-verify' to bypass."
    echo "Tip: run '$SCRIPT doctor --fix' to auto-repair common issues."
    rm -f "$DOCTOR_OUTPUT"
    exit 1
fi
rm -f "$DOCTOR_OUTPUT"

# Check 2: if a task is active and in planning status, warn (don't block)
#   cmd_context prints "Status: <status>" on its own line when a task is active.
#   We capture the full context output and grep for the planning status on
#   that dedicated line (not on the "Active task:" line, which only holds
#   the task path).
CTX_OUTPUT=$(python3 "$SCRIPT" context 2>/dev/null || true)
if echo "$CTX_OUTPUT" | grep -q "Status: planning"; then
    echo ""
    echo "⚠ Warning: An active task is still in 'planning' status."
    echo "  Run 'task start <name>' when ready to begin work."
    # Warning only — don't exit non-zero
fi

# Check 3: WRAP-phase reminder — if the most recent done task shows an
#   incomplete wrap (unchecked PRD criteria / no session recorded), context
#   prints a "Last done task: ... ⚠ ..." line. Surface it here so the commit
#   prompt reminds you to close the loop. Never blocks the commit.
if echo "$CTX_OUTPUT" | grep -q "Last done task:.*⚠"; then
    echo ""
    echo "⚠ Warning: Last done task has an incomplete WRAP phase:"
    echo "$CTX_OUTPUT" | grep "Last done task:" | sed 's/^/  /'
    echo "  Consider: check off prd.md criteria, record a session, commit specs."
    # Warning only — don't exit non-zero
fi

echo "✓ Trellis Lite pre-commit checks passed."
exit 0